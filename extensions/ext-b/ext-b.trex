<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.alex.filtercontext.apply" extension-version="0.1.0">
    <default-locale>fr_FR</default-locale>
    <name>Apply imported filters</name>
    <description>Reads context_id from URL and applies filters on load.</description>
    <author name="Alex" email="alex@example.com" organization="POC" website="https://example.com"/>
    <min-api-version>1.0</min-api-version>

    <source-location>
      <url>https://capable-tanuki-dc4c77.netlify.app/index.html</url>
    </source-location>

    <icon>
      <data>
        iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+X2l0AAAAASUVORK5CYII=
      </data>
    </icon>

    <permissions>
      <permission>full data</permission>
    </permissions>
  </dashboard-extension>
</manifest>


