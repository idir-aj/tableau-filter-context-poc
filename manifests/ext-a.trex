<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.alex.filtercontext.save" extension-version="0.1.0">
    <default-locale>fr_FR</default-locale>
    <name>Save filters &amp; open workbook B</name>
    <description>Capture filters in Workbook A, store context, then navigate to Workbook B.</description>
    <author name="Idir SAIDANI" email="idir.saidani@decathlon.com" organization="Decathlon" website="https://example.com"/>
    <min-api-version>1.0</min-api-version>

    <source-location>
      <url>https://alexjuventiino.github.io/tableau-filter-context-poc/ext-a/index.html?v=20260205-6</url>
    </source-location>

    <icon>iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+X2l0AAAAASUVORK5CYII=</icon>

    <permissions>
      <permission>full data</permission>
    </permissions>
    <context-menu>
      <configure-context-menu-item />
    </context-menu>
  </dashboard-extension>
</manifest>
